# Copy to .env at the repo root and fill in as needed. `docker compose up -d`
# reads POSTGRES_* directly; the API reads DATABASE_URL/REDIS_URL/API_PORT.

NODE_ENV=development
API_PORT=4000

DATABASE_URL=postgres://setu:setu@localhost:5432/setu
POSTGRES_USER=setu
POSTGRES_PASSWORD=setu
POSTGRES_DB=setu

# REDIS_PROVIDER=ioredis (default) uses REDIS_URL below — a persistent TCP
# client, correct for local dev via docker-compose and any long-running
# deploy. Switch to upstash (needed on Vercel — serverless functions don't
# hold persistent TCP connections reliably) and fill in the REST URL/token
# from your Upstash console instead; REDIS_URL is then unused.
REDIS_PROVIDER=ioredis
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated allowed origins for browser clients, or '*' (default) to
# allow any — tighten this to the real PWA origin(s) in production.
CORS_ORIGIN=*

# Auth — phone + SMS OTP. Generate real random secrets for anything beyond
# local dev; these are never committed with real values.
JWT_SECRET=dev-only-change-me
OTP_HASH_SECRET=dev-only-change-me
APPROVAL_SIGNING_SECRET=dev-only-change-me

# Google Sign-In — the OAuth 2.0 *Web application* client id from Google
# Cloud Console (APIs & Services → Credentials). Add your web origin
# (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# Leave blank to disable Google sign-in; phone OTP keeps working.
GOOGLE_OAUTH_CLIENT_ID=

# The first admin (nobody can sign up as admin). Run `npm run db:seed` or
# `npm run admin:bootstrap -w apps/api` after setting either. A phone gets
# an admin account directly; an email is claimed on that Gmail's first
# Google sign-in.
ADMIN_BOOTSTRAP_PHONE=+919999900009
ADMIN_BOOTSTRAP_EMAIL=

# Where the web app is served — the QR code on an approved dossier links
# to $PUBLIC_WEB_URL/verify/<hash>.
PUBLIC_WEB_URL=http://localhost:5173

# SMS_PROVIDER=console (default) logs the OTP instead of sending it, so the
# team can run this with zero credentials. Switch to msg91 and fill in the
# two vars below only once you have real MSG91 credentials.
SMS_PROVIDER=console
MSG91_API_KEY=
MSG91_SENDER_ID=

# AGMARKNET_PROVIDER=mock (default) returns clearly-synthetic mandi prices
# so the team can run this with zero credentials. Switch to real and fill
# in the key below only once you've self-registered a free API key at
# data.gov.in — the shared public demo key is no longer authorized.
AGMARKNET_PROVIDER=mock
AGMARKNET_API_KEY=

# Only a mock exists — no real Account Aggregator partner is integrated
# (see CLAUDE.md). Kept as an explicit switch for symmetry with the other
# providers above; 'mock' is the only accepted value today.
ACCOUNT_AGGREGATOR_PROVIDER=mock

# LLM_PROVIDER=mock (default) returns deterministic "MOCK: ..."-prefixed
# narration so the team can run the whole grounding pipeline — including the
# numeric-mismatch validator — with zero credentials. Switch to real once
# LLM_REAL_PROVIDER's key below is filled in.
LLM_PROVIDER=mock
# gemini (free tier, no card — aistudio.google.com/apikey) is primary;
# groq (free tier — console.groq.com/keys) is the automatic fallback if
# Gemini fails or times out — see llm/client.ts's FallbackLlmProvider.
LLM_REAL_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_STRONG_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Kept for anyone who does have Claude API credits — set
# LLM_REAL_PROVIDER=anthropic to use these instead of Gemini.
ANTHROPIC_API_KEY=
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_STRONG_MODEL=claude-sonnet-5
# One budget shared across up to two sequential calls (primary, then
# fallback) when LLM_PROVIDER=real.
LLM_TIMEOUT_MS=8000

# EMBEDDING_PROVIDER=mock (default) returns deterministic, non-semantic
# vectors — enough to exercise pgvector retrieval end to end with zero
# credentials, but not real similarity search. Switch to real and fill in
# VOYAGE_API_KEY (free tier at voyageai.com) for real embeddings.
EMBEDDING_PROVIDER=mock
VOYAGE_API_KEY=

# GEOCODING_PROVIDER=real (default) reverse-geocodes the Wizard's "use my
# current location" GPS point via OpenStreetMap Nominatim — free, no key
# needed, unlike every other provider above. Set to mock for tests/fully
# offline dev (always returns no match, zero outbound calls). Nominatim's
# usage policy asks for an identifying User-Agent — set GEOCODING_USER_AGENT
# to something naming your deployment/contact if you self-host this.
GEOCODING_PROVIDER=real
GEOCODING_USER_AGENT=

# Google Maps Platform — live ENHANCEMENT layer only (competition density,
# road distances, site-address suggestion); never stored as a dataset. Mock
# default: the report and its enhancement card demo with no key. For real
# calls, enable Places API (New), Routes API and Geocoding API on the key.
# Every call is logged with its SKU; GET /google-maps/usage (admin) reports
# spend. SESSION cap limits one device; DAILY cap is the global ceiling.
GOOGLE_MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_MS=3000
GOOGLE_MAPS_SESSION_CALL_CAP=20
GOOGLE_MAPS_DAILY_CALL_CAP=2000
# FREE TIER ONLY: calls stop at this percent (max 100) of each SKU's monthly
# free allowance, then fall back to free OpenStreetMap services below, then
# to government data only. Also set per-API quotas in Google Cloud Console
# as a hard backstop (see MOCKS.md). GET /google-maps/usage (admin) shows
# this month's free-tier usage.
GOOGLE_MAPS_FREE_TIER_SAFETY_PERCENT=90

# Free, keyless OpenStreetMap fallback (Photon search, OSRM routing,
# Nominatim addresses). 'none' = government data only. Public servers are
# fair-use; self-host and repoint the URLs for large-scale use.
MAP_FALLBACK_PROVIDER=osm
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org
MAP_FALLBACK_TIMEOUT_MS=4000
